{
  "name": "@chatenhancer/repo-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "ci:e2e-artifacts": "node scripts/collect-mock-e2e-artifacts.ts",
    "ci:test-summary": "node scripts/write-ci-test-summary.ts",
    "cloudflare:test": "node scripts/run-cloudflare-tests.ts",
    "coverage:notice": "node scripts/write-coverage-notice.ts",
    "docs:validate-locales": "node scripts/validate-docs-locales.ts",
    "e2e:flake": "node scripts/run-e2e-flake-tests.ts",
    "e2e:open-profile": "node scripts/open-youtube-test-profile.ts",
    "e2e:performance": "node scripts/run-e2e-performance-tests.ts",
    "e2e:test": "node scripts/run-e2e-tests.ts",
    "extension:build": "node scripts/build.ts",
    "lint": "eslint scripts eslint.config.mjs vitest.unit.config.ts",
    "playground:dev": "node scripts/start-cloudflare-playground-dev.ts",
    "publish:chrome": "node scripts/submit-chrome-webstore.ts",
    "publish:firefox": "node scripts/submit-firefox-amo.ts",
    "publish:safari": "node scripts/submit-safari-app-store.ts",
    "release:bump-version": "node scripts/bump-version.ts",
    "release:create-tag": "node scripts/create-release-tag.ts",
    "release:validate-tag": "node scripts/validate-release-tag.ts",
    "release:zip": "node scripts/zip.ts --all",
    "safari:build-app": "node scripts/build-safari-app.ts",
    "safari:configure-signing": "node scripts/configure-safari-signing-assets.ts",
    "safari:distribute": "node scripts/distribute-safari.ts",
    "safari:package": "node scripts/package-safari.ts",
    "setup:playwright": "node scripts/install-playwright-browser.ts",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:unit": "node scripts/run-unit-tests.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "walkthrough:capture": "node scripts/capture-walkthrough-demo.ts",
    "walkthrough:capture-locales": "node scripts/capture-walkthrough-locales.ts",
    "walkthrough:publish": "node scripts/publish-walkthrough-videos.ts"
  },
  "devDependencies": {
    "@chatenhancer/eslint-config": "0.0.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.315",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.27.0",
    "html-minifier-terser": "^7.2.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
